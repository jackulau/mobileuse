# Copy to .env in this directory (or in agent-workspace/.env) and fill in
# YOUR device's values. Both files are .gitignore'd by default.
#
# You only need to fill in the section for the platform you're using.
# Run `mobile-use init` for a guided fill — auto-detects connected devices.

# ============================================================================
# iOS (iphone-harness)
# ============================================================================

# required — iPhone UDID. Find with: `idevice_id -l` or `xcrun xctrace list devices`
IPH_UDID=YOUR-IPHONE-UDID-HERE

# required — Apple Developer Team ID (10 chars).
# Find at developer.apple.com → Membership, or Keychain Access → your Apple Development cert → Get Info → Organizational Unit.
IPH_XCODE_ORG_ID=YOURTEAMID

# required — A reverse-DNS bundle id you can sign. Example: com.<your-handle>.mobile-use.wda
# This becomes the bundle ID of WebDriverAgent on your device.
IPH_WDA_BUNDLE_ID=com.example.mobile-use.wda

# optional — pinned iOS version (Appium usually auto-detects)
# IPH_PLATFORM_VERSION=18.3.2

# optional — device display name (visible in Appium logs)
# IPH_DEVICE_NAME=My iPhone

# optional — non-default Appium server URL
# IPH_APPIUM_URL=http://127.0.0.1:4723

# optional — daemon instance name (for multibox / multiple devices)
# IPH_NAME=default

# optional — enable domain-specific skills (per-app playbooks)
# IPH_DOMAIN_SKILLS=1

# optional — seconds Appium waits between agent calls before killing session
# IPH_NEW_COMMAND_TIMEOUT=600

# optional — point at a prebuilt WebDriverAgent DerivedData dir to skip the
# 20-60s WDA reinstall on every session (auto-detected if you ran `mobile-use ios build-wda`)
# IPH_WDA_DERIVED_DATA_PATH=/Users/you/Library/Developer/Xcode/DerivedData/WebDriverAgent-abc123

# optional — WIRELESS: drive WebDriverAgent over Wi-Fi instead of USB. Set to the
# iPhone's Wi-Fi IP + WDA's port (default 8100). Sets appium:webDriverAgentUrl — WDA
# must already be installed + running (USB once), and on iOS 17+ the RemoteXPC tunnel
# must be up (see SETUP.md → "Wireless (Wi-Fi) control"). `mobile-use --doctor`
# preflights reachability. IPH_CAPS (below) still merges last and can override this.
# IPH_WDA_URL=http://192.168.1.50:8100

# optional — arbitrary Appium capability overrides as a JSON object. Merged last,
# so it can override any default. Use to attach to a pre-running WDA, override
# automationName for a new iOS quirk, set snapshotMaxDepth, etc.
# IPH_CAPS={"appium:webDriverAgentUrl":"http://127.0.0.1:8100","appium:snapshotMaxDepth":30}


# ============================================================================
# Android (android-harness)
# ============================================================================

# required — Android device serial. Find with: `adb devices`.
# WIRELESS: for adb-over-Wi-Fi, run `mobile-use android wifi <ip>` (over USB once) —
# it prints an ip:port serial (e.g. 192.168.1.42:5555) to use here.
ANH_UDID=YOUR-ANDROID-SERIAL-HERE

# optional — pinned Android version
# ANH_PLATFORM_VERSION=14.0

# optional — device display name
# ANH_DEVICE_NAME=Android

# optional — non-default Appium server URL
# ANH_APPIUM_URL=http://127.0.0.1:4723

# optional — daemon instance name (for multibox)
# ANH_NAME=default

# optional — enable domain-specific skills
# ANH_DOMAIN_SKILLS=1

# optional — seconds Appium waits between agent calls before killing session
# ANH_NEW_COMMAND_TIMEOUT=600

# optional — arbitrary Appium capability overrides as a JSON object. Merged last.
# Use for systemPort, automationName overrides, skipServerInstallation, etc.
# ANH_CAPS={"appium:systemPort":8201,"appium:skipServerInstallation":true}

# ---- Perception speed / local detection (all optional, all OFF by default) ----
# Local grounding skips the VLM round-trip on known elements -> faster agent loop.
#
# optional — perception/action cache: replay the action on a repeated identical
# screen and skip the LLM. ON by default; set 0 to disable.
# MU_PERCEPTION_CACHE=1
#
# optional — template element matcher (needs `pip install 'mobile-use[detection]'`).
# Recovers marks on tree-less screens (games/canvas/web views) from captured crops.
# MU_LOCAL_DETECTOR=1
#
# optional — trained YOLO detector as the PRIMARY local grounding path
# (needs `pip install 'mobile-use[yolo]'` + a trained checkpoint). See `train-detector`.
# MU_YOLO_DETECTOR=1
# MU_DETECTOR_WEIGHTS=/path/to/runs/train/weights/best.pt
#
# optional — confidence gate for both local detectors (default 0.78).
# MU_DETECTOR_MIN_CONF=0.78
#
# optional — let a confident, task-named local match TAP DIRECTLY and skip the VLM
# for that step, even when the accessibility tree exists. OFF by default: a wrong
# match becomes a real tap with no VLM gate. Enable only with a trusted detector.
# MU_LOCAL_SHORTCIRCUIT=1

# ---- Steady-state speed (goal/022 — sane defaults, tune only if needed) ----
# pre-act dialog auto-dismiss gating: snapshot (default) skips the per-action
# auto_dismiss device round-trip when the fresh same-step snapshot showed no
# alert; always = dismiss before every action (pre-022); off = never pre-dismiss.
# MU_PREACT_DISMISS=snapshot
#
# gesture-settle multiplier per platform: scales the fixed post-gesture sleeps
# (iOS scroll 1.2s / tap_safe 0.6s / app-switcher 0.6s; Android scroll 0.8s /
# dialog-dismiss 0.5s). 1.0 = stock timing; 0 = no settle (emulators/CI with
# animations off).
# IPH_GESTURE_SETTLE=1.0
# ANH_GESTURE_SETTLE=1.0
#
# ensure_daemon freshness window (seconds): a verified deep probe (real device
# RPC) is trusted this long — within it only the cheap local liveness ping runs.
# 0 = probe on every call (pre-022).
# IPH_ENSURE_TTL=10
# ANH_ENSURE_TTL=10
#
# training-data tree dump: compact (default) keeps grounding-relevant fields,
# capped at MU_COLLECT_TREE_MAX elements per row; full = raw uncapped tree.
# MU_COLLECT_TREE=compact
# MU_COLLECT_TREE_MAX=150
